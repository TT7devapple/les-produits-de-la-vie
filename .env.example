# Copier ce fichier en .env.local et compléter.

# Nom de domaine définitif du site (sitemap, URL canoniques, partages sur les réseaux)
NEXT_PUBLIC_SITE_URL=https://www.exemple-du-domaine.fr

# URL qui reçoit les messages du formulaire de contact (POST JSON).
# Exemple : un formulaire Formspree (https://formspree.io/f/xxxxxxx), un scénario Make/Zapier…
# Tant qu'elle est vide, le formulaire invite le visiteur à appeler ou à passer en boutique.
CONTACT_FORM_ENDPOINT=

# ——— Onglet « Commander » ———
# Paiement en ligne (Stripe Checkout). Clé secrète du compte Stripe de la boutique
# (sk_live_… en production, sk_test_… pour tester). Sans elle, pas de paiement en ligne.
STRIPE_SECRET_KEY=

# Commandes « paiement au retrait » : envoi par e-mail via Resend (https://resend.com)…
RESEND_API_KEY=
# … à cette adresse (plusieurs possibles, séparées par des virgules)
ORDER_EMAIL_TO=
# Expéditeur vérifié dans Resend (sinon l'adresse de test onboarding@resend.dev)
ORDER_EMAIL_FROM=
# … et/ou vers un webhook qui reçoit la commande en JSON (Make, Zapier, n8n…)
ORDER_WEBHOOK_URL=
